{
  "name": "otf-exercise-directory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run docs:check && npm run test:catalog",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "docs:generate": "node scripts/docs-parity.mjs --write",
    "docs:check": "node scripts/docs-parity.mjs --check",
    "legacy-routes:generate": "node scripts/generate-legacy-exercise-routes.mjs --write",
    "legacy-routes:check": "node scripts/generate-legacy-exercise-routes.mjs --check",
    "refresh": "./scripts/refresh.sh",
    "refresh:apply": "./scripts/refresh.sh --apply",
    "thumbnails": "node scripts/ensure-thumbnails.mjs",
    "test:data": "python3 -m unittest tests/test_refresh_incremental.py",
    "test:docs": "node --test tests/docs-parity.test.mjs",
    "test:directory": "node --test tests/directory-query.test.mjs",
    "test:security": "node --test tests/shell-security.test.mjs",
    "test:thumbnails": "node --test tests/thumbnail-pipeline.test.mjs",
    "test:catalog": "node --test tests/catalog-integrity.test.mjs tests/legacy-exercise-routes.test.mjs && npm run legacy-routes:check && node scripts/check_catalog_integrity.mjs --latest-thumbnail-report",
    "test:redesign": "node tests/redesign-browser.mjs",
    "test:e2e": "node tests/ui-overhaul-smoke.mjs",
    "test:ui-overhaul": "node tests/ui-overhaul-smoke.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "fuse.js": "^7.1.0",
    "next": "16.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "marked": "^18.0.6",
    "playwright": "^1.58.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
